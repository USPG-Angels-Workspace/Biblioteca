@model List<Usuario>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Gestión de usuarios</h1>
    <a href="#modal-agregar" class="bg-blue-600 hover:bg-blue-700 text-white rounded px-4 py-2">Agregar usuario</a>
</div>

@if (TempData["Error"] != null)
{
    <p class="text-red-600 text-sm mb-4">@TempData["Error"]</p>
}

<form method="get" asp-action="Index" class="mb-6 flex gap-2">
    <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por nombre o identificación"
           class="border border-slate-300 rounded px-3 py-2 flex-1" />
    <button type="submit" class="bg-slate-700 hover:bg-slate-800 text-white rounded px-4 py-2">Buscar</button>
    <a asp-action="Index" class="bg-slate-200 hover:bg-slate-300 text-slate-800 rounded px-4 py-2">Limpiar</a>
</form>

<table class="w-full bg-white rounded shadow overflow-hidden">
    <thead class="bg-slate-100 text-left text-sm text-slate-600">
        <tr>
            <th class="px-4 py-2">Nombre</th>
            <th class="px-4 py-2">Carnet</th>
            <th class="px-4 py-2">Email</th>
            <th class="px-4 py-2">Fecha de registro</th>
            <th class="px-4 py-2"></th>
        </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
        @foreach (var usuario in Model)
        {
            <tr>
                <td class="px-4 py-2">@usuario.GetNombre()</td>
                <td class="px-4 py-2">@usuario.GetIdentificacion()</td>
                <td class="px-4 py-2">@usuario.GetEmail()</td>
                <td class="px-4 py-2">@usuario.GetFechaRegistro().ToShortDateString()</td>
                <td class="px-4 py-2 space-x-2 whitespace-nowrap">
                    <a href="#modal-editar-@usuario.GetId()" class="text-blue-600 hover:underline">Editar</a>
                    <form method="post" asp-action="Eliminar" class="inline">
                        <input type="hidden" name="id" value="@usuario.GetId()" />
                        <button type="submit" class="text-red-600 hover:underline">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div id="modal-agregar" class="modal fixed inset-0 bg-black/50 items-center justify-center p-4 z-50">
    <div class="bg-white rounded shadow-lg p-6 w-full max-w-lg relative">
        <a href="#" class="absolute top-3 right-4 text-slate-400 hover:text-slate-700 text-xl leading-none">&times;</a>
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Agregar usuario</h2>
        <p class="text-xs text-slate-500 -mt-2 mb-2">El carnet se asigna automáticamente.</p>
        <form method="post" asp-action="Guardar" class="grid grid-cols-1 gap-4">
            <input type="hidden" name="id" value="0" />
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
                <input type="text" name="nombre" required class="w-full border border-slate-300 rounded px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                <input type="email" name="email" required class="w-full border border-slate-300 rounded px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Contraseña</label>
                <input type="password" name="contrasena" required class="w-full border border-slate-300 rounded px-3 py-2" />
            </div>
            <div class="flex justify-end gap-2 mt-2">
                <a href="#" class="bg-slate-200 hover:bg-slate-300 text-slate-800 rounded px-4 py-2">Cancelar</a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded px-4 py-2">Agregar</button>
            </div>
        </form>
    </div>
</div>

@foreach (var usuario in Model)
{
    <div id="modal-editar-@usuario.GetId()" class="modal fixed inset-0 bg-black/50 items-center justify-center p-4 z-50">
        <div class="bg-white rounded shadow-lg p-6 w-full max-w-lg relative">
            <a href="#" class="absolute top-3 right-4 text-slate-400 hover:text-slate-700 text-xl leading-none">&times;</a>
            <h2 class="text-lg font-semibold text-slate-800 mb-4">Editar usuario</h2>
            <form method="post" asp-action="Guardar" class="grid grid-cols-1 gap-4">
                <input type="hidden" name="id" value="@usuario.GetId()" />
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
                    <input type="text" name="nombre" value="@usuario.GetNombre()" required
                           class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Carnet (año + número, ej. 2600100)</label>
                    <input type="text" name="identificacion" value="@usuario.GetIdentificacion()" required
                           pattern="\d{7}" title="7 dígitos: año + número, ej. 2600100"
                           class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                    <input type="email" name="email" value="@usuario.GetEmail()" required
                           class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Contraseña</label>
                    <input type="password" name="contrasena" placeholder="Dejar en blanco para no cambiarla"
                           class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div class="flex justify-end gap-2 mt-2">
                    <a href="#" class="bg-slate-200 hover:bg-slate-300 text-slate-800 rounded px-4 py-2">Cancelar</a>
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded px-4 py-2">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
}
