@model List<Usuario>
@{
    var editando = ViewBag.UsuarioEditando as Usuario;
}

<h1 class="text-2xl font-bold text-slate-800 mb-6">Gestión de usuarios</h1>

@if (TempData["Error"] != null)
{
    <p class="text-red-600 text-sm mb-4">@TempData["Error"]</p>
}

<form method="get" asp-action="Index" class="mb-6 flex gap-2">
    <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por nombre o identificación"
           class="border border-slate-300 rounded px-3 py-2 flex-1" />
    <button type="submit" class="bg-slate-700 hover:bg-slate-800 text-white rounded px-4 py-2">Buscar</button>
    <a asp-action="Index" class="bg-slate-200 hover:bg-slate-300 text-slate-800 rounded px-4 py-2">Limpiar</a>
</form>

<form method="post" asp-action="Guardar" class="bg-white rounded shadow p-6 mb-6 grid grid-cols-2 gap-4">
    <input type="hidden" name="id" value="@(editando?.GetId() ?? 0)" />
    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
        <input type="text" name="nombre" value="@(editando?.GetNombre())" required
               class="w-full border border-slate-300 rounded px-3 py-2" />
    </div>
    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Identificación</label>
        <input type="text" name="identificacion" value="@(editando?.GetIdentificacion())" required
               class="w-full border border-slate-300 rounded px-3 py-2" />
    </div>
    <div class="col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1">Contacto</label>
        <input type="text" name="contacto" value="@(editando?.GetContacto())"
               class="w-full border border-slate-300 rounded px-3 py-2" />
    </div>
    <div class="col-span-2 flex gap-2 items-end">
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded px-4 py-2">
            @(editando != null ? "Guardar cambios" : "Agregar usuario")
        </button>
        @if (editando != null)
        {
            <a asp-action="Index" class="bg-slate-200 hover:bg-slate-300 text-slate-800 rounded px-4 py-2">Cancelar</a>
        }
    </div>
</form>

<table class="w-full bg-white rounded shadow overflow-hidden">
    <thead class="bg-slate-100 text-left text-sm text-slate-600">
        <tr>
            <th class="px-4 py-2">Nombre</th>
            <th class="px-4 py-2">Identificación</th>
            <th class="px-4 py-2">Contacto</th>
            <th class="px-4 py-2">Fecha de registro</th>
            <th class="px-4 py-2"></th>
        </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
        @foreach (var usuario in Model)
        {
            <tr>
                <td class="px-4 py-2">@usuario.GetNombre()</td>
                <td class="px-4 py-2">@usuario.GetIdentificacion()</td>
                <td class="px-4 py-2">@usuario.GetContacto()</td>
                <td class="px-4 py-2">@usuario.GetFechaRegistro().ToShortDateString()</td>
                <td class="px-4 py-2 space-x-2 whitespace-nowrap">
                    <a asp-action="Index" asp-route-editarId="@usuario.GetId()" asp-route-buscar="@ViewBag.Buscar"
                       class="text-blue-600 hover:underline">Editar</a>
                    <form method="post" asp-action="Eliminar" class="inline">
                        <input type="hidden" name="id" value="@usuario.GetId()" />
                        <button type="submit" class="text-red-600 hover:underline">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
