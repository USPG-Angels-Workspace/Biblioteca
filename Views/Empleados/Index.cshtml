@model List<Bibliotecario>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Gestión de empleados</h1>
    <a href="#modal-agregar" class="bg-blue-600 hover:bg-blue-700 text-white rounded px-4 py-2">Agregar empleado</a>
</div>

@if (TempData["Error"] != null)
{
    <p class="text-red-600 text-sm mb-4">@TempData["Error"]</p>
}

<table class="w-full bg-white rounded shadow overflow-hidden">
    <thead class="bg-slate-100 text-left text-sm text-slate-600">
        <tr>
            <th class="px-4 py-2">Nombre</th>
            <th class="px-4 py-2">Identificación</th>
            <th class="px-4 py-2">Contacto</th>
            <th class="px-4 py-2">Usuario</th>
            <th class="px-4 py-2"></th>
        </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
        @foreach (var empleado in Model)
        {
            <tr>
                <td class="px-4 py-2">@empleado.GetNombre()</td>
                <td class="px-4 py-2">@empleado.GetIdentificacion()</td>
                <td class="px-4 py-2">@empleado.GetContacto()</td>
                <td class="px-4 py-2">@empleado.GetNombreUsuario()</td>
                <td class="px-4 py-2 space-x-2 whitespace-nowrap">
                    <a href="#modal-editar-@empleado.GetId()" class="text-blue-600 hover:underline">Editar</a>
                    <form method="post" asp-action="Eliminar" class="inline">
                        <input type="hidden" name="id" value="@empleado.GetId()" />
                        <button type="submit" class="text-red-600 hover:underline">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div id="modal-agregar" class="modal fixed inset-0 bg-black/50 items-center justify-center p-4 z-50">
    <div class="bg-white rounded shadow-lg p-6 w-full max-w-lg relative">
        <a href="#" class="absolute top-3 right-4 text-slate-400 hover:text-slate-700 text-xl leading-none">&times;</a>
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Agregar empleado</h2>
        <form method="post" asp-action="Guardar" class="grid grid-cols-1 gap-4">
            <input type="hidden" name="id" value="0" />
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
                <input type="text" name="nombre" required class="w-full border border-slate-300 rounded px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Identificación</label>
                <input type="text" name="identificacion" required class="w-full border border-slate-300 rounded px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Contacto</label>
                <input type="text" name="contacto" class="w-full border border-slate-300 rounded px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Usuario</label>
                <input type="text" name="nombreUsuario" required class="w-full border border-slate-300 rounded px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Contraseña</label>
                <input type="password" name="contrasena" required class="w-full border border-slate-300 rounded px-3 py-2" />
            </div>
            <div class="flex justify-end gap-2 mt-2">
                <a href="#" class="bg-slate-200 hover:bg-slate-300 text-slate-800 rounded px-4 py-2">Cancelar</a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded px-4 py-2">Agregar</button>
            </div>
        </form>
    </div>
</div>

@foreach (var empleado in Model)
{
    <div id="modal-editar-@empleado.GetId()" class="modal fixed inset-0 bg-black/50 items-center justify-center p-4 z-50">
        <div class="bg-white rounded shadow-lg p-6 w-full max-w-lg relative">
            <a href="#" class="absolute top-3 right-4 text-slate-400 hover:text-slate-700 text-xl leading-none">&times;</a>
            <h2 class="text-lg font-semibold text-slate-800 mb-4">Editar empleado</h2>
            <form method="post" asp-action="Guardar" class="grid grid-cols-1 gap-4">
                <input type="hidden" name="id" value="@empleado.GetId()" />
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
                    <input type="text" name="nombre" value="@empleado.GetNombre()" required
                           class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Identificación</label>
                    <input type="text" name="identificacion" value="@empleado.GetIdentificacion()" required
                           class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Contacto</label>
                    <input type="text" name="contacto" value="@empleado.GetContacto()" class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Usuario</label>
                    <input type="text" name="nombreUsuario" value="@empleado.GetNombreUsuario()" required
                           class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Contraseña</label>
                    <input type="password" name="contrasena" placeholder="Dejar en blanco para no cambiarla"
                           class="w-full border border-slate-300 rounded px-3 py-2" />
                </div>
                <div class="flex justify-end gap-2 mt-2">
                    <a href="#" class="bg-slate-200 hover:bg-slate-300 text-slate-800 rounded px-4 py-2">Cancelar</a>
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded px-4 py-2">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
}
